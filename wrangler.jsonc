{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zaotu-ai-product-studio",
  "main": "./worker.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "observability": {
    "enabled": true
  }
}
