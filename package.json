{
  "name": "ai-image-workbench",
  "version": "2.0.0",
  "description": "AI商品图片工作台 - 面向中国大陆电商卖家",
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/prepare-hosting.mjs",
    "start": "vinext start",
    "check": "node --check lib/api.js && node --check app/api/[endpoint]/route.js && node --check worker.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.2.6",
    "vinext": "^1.0.0-beta.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "vite": "^8.0.0",
    "wrangler": "^4.123.0"
  }
}
